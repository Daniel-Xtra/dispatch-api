# Node
NODE_ENV=
PORT=
SERVICE_NAME=

# PostgreSQL
# Host apps use localhost; Compose overrides DATABASE_HOST to "postgres" for containers.
DATABASE_HOST=
DATABASE_PORT=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=

# Redis
REDIS_HOST=
REDIS_PORT=

# RabbitMQ
# Host apps use localhost URL; Compose rebuilds the URL with host "rabbitmq".
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_PORT=
RABBITMQ_MANAGEMENT_PORT=
RABBITMQ_URL=
